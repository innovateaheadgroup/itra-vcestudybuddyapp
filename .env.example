APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vce_prep_buddy
JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-refresh-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
BUDDY_SCORING_REFUSAL_PATTERNS=write my sac answer,write my sat answer,do my sac,do my sat
CODE_RUN_RATE_LIMIT_PER_MINUTE=20
CODE_RUN_TIMEOUT_SECONDS=3
MAX_UPLOAD_SIZE_MB=10
FRONTEND_URL=http://localhost:5173
